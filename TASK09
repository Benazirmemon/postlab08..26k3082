#include <stdio.h>

void checkBalance(float balance);
float depositMoney(float balance);
float withdrawMoney(float balance);

int main() {
    float balance = 20000.0;
    int choice;

    while (1) {
        printf("\nATM TRANSACTION SYSTEM\n");
        printf("1. Check Balance\n");
        printf("2. Deposit Money\n");
        printf("3. Withdraw Money\n");
        printf("4. Exit\n");
        
        printf("Enter your choice (1-4): ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                checkBalance(balance);
                break;

            case 2:
                balance = depositMoney(balance);
                break;

            case 3:
                balance = withdrawMoney(balance);
                break;

            case 4:
                printf("\nThank you for using the ATM Transaction System. Goodbye!\n");
                return 0;

            default:
                printf("\nInvalid choice! Please select a valid option from the menu.\n");
        }
    }

    return 0;
}

void checkBalance(float balance) {
    printf("\nYour current balance is: Rs. %.2f\n", balance);
}

float depositMoney(float balance) {
    float amount;
    printf("\nEnter the amount to deposit: Rs. ");
    scanf("%f", &amount);

    if (amount <= 0) {
        printf("Error: Deposit amount must be positive.\n");
    } else {
        balance += amount;
        printf("Successfully deposited Rs. %.2f\n", amount);
        printf("Updated balance: Rs. %.2f\n", balance);
    }
    return balance;
}

float withdrawMoney(float balance) {
    float amount;
    printf("\nEnter the amount to withdraw: Rs. ");
    scanf("%f", &amount);

    if (amount <= 0) {
        printf("Error: Withdrawal amount must be positive.\n");
    } else if (amount > 10000) {
        printf("Error: Cannot withdraw more than Rs. 10,000 per transaction.\n");
    } else if (amount > balance) {
        printf("Error: Insufficient balance. Available balance is Rs. %.2f\n", balance);
    } else {
        balance -= amount;
        printf("Successfully withdrew Rs. %.2f\n", amount);
        printf("Updated balance: Rs. %.2f\n", balance);

        if (balance < 5000) {
            printf(" WARNING: Your balance has fallen below Rs5,000. Low balance a\n");
        }
    }
    return balance;
}
