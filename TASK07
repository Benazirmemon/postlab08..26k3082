#include <stdio.h>


int isEven(int num);
int isPalindrome(int num);
int isPrime(int num);

int main() {
    int number;

    
   
    do {
        printf("Enter a positive integer: ");
        scanf("%d", &number);
        if (number <= 0) {
            printf("Invalid input! Please enter a number greater than 0.\n");
        }
    } while (number <= 0);

    printf("Analysis Results for %d\n ", number);

    if (isEven(number)) {
        printf(" even\n");
    } else {
        printf("odd\n");
    }

    if (isPalindrome(number)) {
        printf(" Palindrome: YES (Reads the same backwards)\n");
    } else {
        printf("not palindrome\n");
    }

    if (isPrime(number)) {
        printf("-> Prime Number\n");
    } else {
        printf("not Prime Number\n");
    }

    return 0;
}

int isEven(int num) {
    return (num % 2 == 0);
}

int isPalindrome(int num) {
    int originalNum = num;
    int reversedNum = 0;
    int remainder;

    while (num > 0) {
        remainder = num % 10;                  
        reversedNum = (reversedNum * 10) + remainder; 
        num = num / 10;                        
    }

    return (originalNum == reversedNum); 
}

int isPrime(int num) {
    if (num <= 1) return 0; 
    
    for (int i = 2; i <= num/2; i++) { 
        if (num % i == 0) {
            return 0; 
        }
    }
    return 1; 
}
